# CouchSpire settings. Copy to CouchSpire.cfg in the repo root; deploy.sh installs it next to the mod.
# Environment variables (COUCHSPIRE_PROBE etc.) override these; on Mac, use this file instead,
# because Steam for Mac doesn't support "VAR=value %command%" launch options.

# Verbose input diagnostics in the game log, plus the debug overlay at startup.
probe = 0

# Per-controller routing (each controller drives its own character). 0 = plain Local Multi-Control.
routing = 1

# Show the debug overlay at startup (F10 toggles it anyway).
overlay = 0

# Simultaneous combat: the driver keeps the screen all combat; the other character acts as a remote teammate.
# 0 = the fork's hotseat behavior (auto-switch after end turn, the teammate's choices on the main screen).
simultaneous = 1

# Teammate HUD placement (game UI coordinates of its top-left corner) and card scale.
# By default the HUD's top lines up with the players list on the left, below P1's relic row; set hud_y to pin it.
hud_x = 300
# hud_y = 170
hud_scale = 0.45

# P1's hand size in couch co-op (1 = the game's size; the hovered card uses it too).
p1_hand_scale = 0.85
# P1's hand shifted sideways in pixels (negative = left), so raised cards stay off the enemies on the right.
p1_hand_offset = -200

# Screenshots for UI work: F11 saves one any time. shots = 1 also saves one each time a P2 screen or HUD mode opens.
# They go to the game's user folder, under couch_shots/.
shots = 0
